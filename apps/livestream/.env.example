# What this deployment does. The checkpoint's own shape -- clip length, canvas,
# kernels, GPU count -- is in serve_configs/fasth3.yaml instead.
# Copy to .env and fill in. Keep it chmod 600: it holds live API keys.

# ---------------------------------------------------------------- model ----
# The FastH3 weights bundle. Checked for completeness at startup.
LIVESTREAM_WEIGHTS_PATH=/path/to/weights/fasth3
# Override the engine YAML (default: serve_configs/fasth3.yaml).
# LIVESTREAM_MODEL_CONFIG=

# ----------------------------------------------------------- upsampling ----
# Any OpenAI-compatible endpoint: a proxy, a local vLLM, Groq, OpenRouter.
# The upsampler asks for response_format=json_object.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# The creative preset: the style every rewritten scene is written in plus the
# idle prompts that keep the stream fed. A bare name loads
# livestream/presets/<name>.json; a path or *.json value loads that file.
# Shipped: unhinged (mashups, the default), variety (iconic properties as
# themselves), default (the original conservative set).
PRESET=unhinged

# Most clips one chat prompt may expand into: one scene, or a short story
# played back-to-back.
MAX_CHUNKS=6

# Filler always wears the preset's style; a viewer's own request may pick
# whatever look suits it. 0 puts every clip in the house style.
VIEWER_FREE_STYLE=1

# ----------------------------------------------------------- moderation ----
# A SEPARATE endpoint on purpose: inference gateways often do not expose
# /moderations, so point these at api.openai.com even when upsampling goes
# elsewhere. Errors fail closed. Unset, they fall back to OPENAI_API_KEY/URL.
MODERATION_ENABLED=1
# MODERATION_API_KEY=
# MODERATION_BASE_URL=https://api.openai.com/v1
MODERATION_MODEL=omni-moderation-latest

# ---------------------------------------------------------- idle filler ----
# With chat quiet, generated prompts keep the queues topped up to this many
# clips so the stream never runs dry. Self-clamps below playout capacity.
# 0 disables, as does a preset with an empty idle_prompts list.
IDLE_QUEUE_TARGET=6

# --------------------------------------------------------------- output ----
# Where the HLS playlist and segments are written. The page serves them from
# here, so one origin -- and one tunnel -- carries the whole demo.
HLS_DIR=./hls
# x264 target in kbit/s (maxrate ~1.2x, bufsize ~2x).
VIDEO_BITRATE_K=4500

# ------------------------------------------------------------------ web ----
WEB_HOST=0.0.0.0
WEB_PORT=8081

# ----------------------------------------------------------------- chat ----
CHAT_COMMAND=!prompt
# Per-author cooldown between accepted prompts, seconds.
CHAT_COOLDOWN_S=30
