# What this deployment does. The checkpoint's own shape -- clip length,
# canvas, kernels, GPU count -- is in serve_configs/fasth3.yaml instead.
# Copy to .env and fill in. Keep it chmod 600: it holds live API keys.

# ---------------------------------------------------------------- model ----
# The FastH3 weights bundle. Checked for completeness at startup.
LIVESTREAM_WEIGHTS_PATH=/path/to/weights/fasth3
# Override the engine YAML (default: serve_configs/fasth3.yaml).
# LIVESTREAM_MODEL_CONFIG=

# ----------------------------------------------------------- upsampling ----
# Any OpenAI-compatible endpoint: set OPENAI_BASE_URL for a proxy, a local
# vLLM, Groq, OpenRouter. The upsampler asks for response_format=json_object.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# The creative preset: the style every rewritten scene is written in plus the
# idle prompts that keep the stream fed. A bare name loads
# livestream/presets/<name>.json; a path or *.json value loads that file.
PRESET=default

# Most clips one chat prompt may expand into: one scene, or a short story
# played back-to-back.
MAX_CHUNKS=6

# ----------------------------------------------------------- moderation ----
# Viewer prompts are checked before they reach the upsampler. A SEPARATE
# endpoint on purpose: inference gateways often do not expose /moderations,
# so point these at api.openai.com even when upsampling goes elsewhere.
# Errors fail closed. Unset, they fall back to OPENAI_API_KEY/BASE_URL.
MODERATION_ENABLED=1
# MODERATION_API_KEY=
# MODERATION_BASE_URL=https://api.openai.com/v1
MODERATION_MODEL=omni-moderation-latest

# ---------------------------------------------------------- idle filler ----
# With chat quiet, generated prompts keep the queues topped up to this many
# clips so the stream never runs dry. Self-clamps below playout capacity.
# 0 disables, as does a preset with an empty idle_prompts list.
IDLE_QUEUE_TARGET=6

# --------------------------------------------------------------- output ----
# Burn live status into every frame. Off when the web page is on -- the page
# already shows the title and queue.
OVERLAY_ENABLED=1

# hls | rtmp | noop. The web page plays the HLS playlist this writes, so
# WEB_ENABLED=1 requires SINK=hls.
SINK=hls
HLS_DIR=./hls
# Twitch:  rtmp://live.twitch.tv/app/<STREAM_KEY>
# YouTube: rtmp://a.rtmp.youtube.com/live2/<STREAM_KEY>
RTMP_URL=
# x264 target in kbit/s (maxrate ~1.2x, bufsize ~2x).
RTMP_VIDEO_BITRATE_K=4500

# ------------------------------------------------------------------ web ----
# The watch page: video, live chat and the queue, on one HTTP origin so a
# single tunnel publishes the whole thing.
WEB_ENABLED=1
WEB_HOST=0.0.0.0
WEB_PORT=8081

# ----------------------------------------------------------------- chat ----
CHAT_COMMAND=!prompt
# Per-author cooldown between accepted prompts, seconds.
CHAT_COOLDOWN_S=30
# Twitch chat is read anonymously over IRC; only the channel name is needed.
TWITCH_CHANNEL=
# YouTube needs the live broadcast's video id and a Data API v3 key.
YOUTUBE_VIDEO_ID=
YOUTUBE_API_KEY=

# --------------------------------------------------------------- admins ----
# Usernames allowed to send admin commands, comma-separated, matched
# case-insensitively. Scope with `twitch:name` when a display name could be
# two people. Empty disables admin commands.
#   !switch <preset>   swap the creative preset live
ADMIN_USERS=
